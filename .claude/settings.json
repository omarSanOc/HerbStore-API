{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format --check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(uv lock --check:*)",
      "Bash(docker compose config:*)"
    ]
  }
}
